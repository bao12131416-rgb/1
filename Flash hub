local noclipConn
createFeatureRow("1. Noclip", function(state)
    noclipState = state
    if state then
        noclipConn = RunService.Stepped:Connect(function()
            if character then
                for _, part in ipairs(character:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        if noclipConn then
            noclipConn:Disconnect()
            noclipConn = nil
        end
        if character then
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
    end
end)

local platformPart = nil
local function removePlatform()
    if platformPart then
        platformPart:Destroy()
        platformPart = nil
    end
end

local domainActive = false
createFeatureRow("2. 0.2s Domain", function(state)
    domainActive = state
    task.spawn(function()
        while domainActive do
            local targets = {}
            for _, otherPlayer in ipairs(Players:GetPlayers()) do
                if otherPlayer ~= player and otherPlayer.Character and otherPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    table.insert(targets, otherPlayer.Character.HumanoidRootPart)
                end
            end
            
            if #targets == 0 then
                removePlatform()
                if humanoidRootPart then
                    platformPart = Instance.new("Part")
                    platformPart.Size = Vector3.new(100, 1, 100)
                    platformPart.Anchored = true
                    platformPart.Position = humanoidRootPart.Position + Vector3.new(0, 120, 0)
                    platformPart.BrickColor = BrickColor.new("Really black")
                    platformPart.Material = Enum.Material.SmoothPlastic
                    platformPart.Parent = Workspace
                    
                    local startTime = tick()
                    -- Giảm thời gian bay tới xuống 0.005s
                    while domainActive and #Players:GetPlayers() <= 1 and (tick() - startTime) < 0.005 do
                        humanoidRootPart.CFrame = platformPart.CFrame + Vector3.new(0, 4, 0)
                        task.wait()
                    end
                end
                
                -- Giảm thời gian ở lại xuống 0.005s
                local stayStart = tick()
                while domainActive and #Players:GetPlayers() <= 1 and (tick() - stayStart) < 0.005 do
                    task.wait()
                end
                removePlatform()
            else
                for _, targetRoot in ipairs(targets) do
                    if not domainActive then break end
                    
                    local startTime = tick()
                    -- Giảm thời gian bay tới mục tiêu xuống 0.005s
                    while domainActive and targetRoot and targetRoot.Parent and (tick() - startTime) < 0.005 do
                        if humanoidRootPart then
                            humanoidRootPart.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
                        end
                        task.wait()
                    end
                    
                    -- Thời gian ở lại tại mỗi mục tiêu là 0.005s
                    local stayStart = tick()
                    while domainActive and targetRoot and targetRoot.Parent and (tick() - stayStart) < 0.005 do
                        if humanoidRootPart then
                            humanoidRootPart.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
                        end
                        task.wait()
                    end
                end
            end
            task.wait()
        end
        removePlatform()
    end)
end)

createActionButton("3. Auto Void", function()
    task.spawn(function()
        if not humanoidRootPart then return end
        
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(0, math.huge, 0)
        bv.Velocity = Vector3.new(0, 55, 0)
        bv.Parent = humanoidRootPart
        
        local targetY = humanoidRootPart.Position.Y + 70
        while humanoidRootPart.Position.Y < targetY do
            task.wait()
        end
        
        bv.Velocity = Vector3.new(0, 0, 0)
        
        local raycastParams = RaycastParams.new()
        raycastParams.FilterDescendantsInstances = {character}
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        
        local foundVoidPos = nil
        local scanRadius = 50
        local angles = {0, 60, 120, 180, 240, 300}
        
        while not foundVoidPos do
            for _, angle in ipairs(angles) do
                local rad = math.rad(angle)
                local checkPos = humanoidRootPart.Position + Vector3.new(math.cos(rad) * scanRadius, 0, math.sin(rad) * scanRadius)
                local rayResult = Workspace:Raycast(checkPos, Vector3.new(0, -600, 0), raycastParams)
                
                if not rayResult then
                    foundVoidPos = checkPos + Vector3.new(0, 10, 0)
                    break
                end
            end
            if not foundVoidPos then
                scanRadius = scanRadius + 30
                task.wait(0.05)
            end
        end
        
        if foundVoidPos then
            local moveTween = TweenService:Create(
                humanoidRootPart,
                TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                {CFrame = CFrame.new(foundVoidPos)}
            )
            moveTween:Play()
            moveTween.Completed:Wait()
        end
        
        bv:Destroy()
        showNotification("Void found", false)
    end)
end)
