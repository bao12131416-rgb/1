local activeNotifications = {}

local function updateNotificationPositions()
    for index, notifObj in ipairs(activeNotifications) do
        if notifObj and notifObj.Parent then
            local targetYOffset = (index - 1) * 30
            notifObj.Position = UDim2.new(0.5, -140, 0.1, targetYOffset)
        end
    end
end

local function showNotification(text, isError)
    local notif = Instance.new("TextLabel")
    notif.Parent = screenGui
    notif.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    notif.BackgroundTransparency = 0.4
    notif.BorderSizePixel = 0
    notif.Size = UDim2.new(0, 280, 0, 26)
    notif.Font = Enum.Font.SourceSansBold
    notif.Text = text
    notif.TextColor3 = isError and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(0, 255, 0)
    notif.TextSize = 13
    
    local notifCorner = Instance.new("UICorner")
    notifCorner.CornerRadius = UDim.new(0, 5)
    notifCorner.Parent = notif
    
    table.insert(activeNotifications, notif)
    updateNotificationPositions()
    
    task.spawn(function()
        task.wait(2)
        local foundIndex = table.find(activeNotifications, notif)
        if foundIndex then
            table.remove(activeNotifications, foundIndex)
        end
        notif:Destroy()
        updateNotificationPositions()
    end)
end

local noclipState = false

local function createFeatureRow(name, callback)
    local row = Instance.new("Frame")
    row.Parent = contentContainer
    row.BackgroundColor3 = Color3.fromRGB(255, 245, 157)
    row.BorderSizePixel = 0
    row.Size = UDim2.new(0, 260, 0, 24)
    
    local rowCorner = Instance.new("UICorner")
    rowCorner.CornerRadius = UDim.new(0, 4)
    rowCorner.Parent = row
    
    local rowStroke = Instance.new("UIStroke")
    rowStroke.Parent = row
    rowStroke.Color = Color3.fromRGB(244, 67, 54)
    rowStroke.Thickness = 1
    
    local label = Instance.new("TextLabel")
    label.Parent = row
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0.04, 0, 0, 0)
    label.Size = UDim2.new(0.65, 0, 1, 0)
    label.Font = Enum.Font.SourceSansBold
    label.Text = name
    label.TextColor3 = Color3.fromRGB(50, 50, 50)
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    
    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Parent = row
    toggleBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    toggleBtn.BorderSizePixel = 0
    toggleBtn.Position = UDim2.new(1, -44, 0.5, -8)
    toggleBtn.Size = UDim2.new(0, 38, 0, 16)
    toggleBtn.Font = Enum.Font.SourceSansBold
    toggleBtn.Text = "OFF"
    toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleBtn.TextSize = 10
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 3)
    btnCorner.Parent = toggleBtn
    
    local active = false
    
    local function updateState(newState)
        active = newState
        if active then
            toggleBtn.BackgroundColor3 = Color3.fromRGB(46, 125, 50)
            toggleBtn.Text = "ON"
        else
            toggleBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
            toggleBtn.Text = "OFF"
        end
        callback(active)
    end
    
    toggleBtn.MouseButton1Click:Connect(function()
        if name == "2. 0.2s Domain" and not noclipState then
            showNotification("Turn on the noclip", true)
            return
        end
        updateState(not active)
    end)
    
    return updateState, toggleBtn
end

