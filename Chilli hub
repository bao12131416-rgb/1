local function safeReplace(str, findStr, replaceStr)
    local startIdx, endIdx = str:find(findStr, 1, true)
    if startIdx then
        return str:sub(1, startIdx - 1) .. replaceStr .. str:sub(endIdx + 1)
    end
    return str
end

